# Local wrangler secrets — copy to worker/.dev.vars (gitignored).
# Production: printf '%s' '...' | npx wrangler secret put VAPID_PRIVATE_KEY --config worker/wrangler.toml
VAPID_PRIVATE_KEY=

# Required for /admin/* registry writes
SUPABASE_SERVICE_KEY=

# Required for Places lookup / Details (website enrich in booking QA)
GOOGLE_PLACES_KEY=

# Required for /admin/* (same service role key as production)
SUPABASE_SERVICE_KEY=
